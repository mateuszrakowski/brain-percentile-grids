# Application
DEBUG=false
ENVIRONMENT=production
SECRET_KEY=change-me-generate-a-real-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DB_URL=postgresql://user:password@localhost:5432/grids_db

# CORS (comma-separated frontend URLs)
CORS_ORIGINS=https://myapp.com,https://admin.myapp.com

# File upload settings (optional - defaults usually work)
# MAX_UPLOAD_SIZE=16777216
# MAX_FILES_COUNT=300
# UPLOAD_FOLDER=./uploads

# Model storage (optional)
# MODELS_DIR=./models

# R environment (optional - only if auto-detect fails)
# R_HOME=/usr/lib/R
# R_LIBS=/usr/local/lib/R/site-library
